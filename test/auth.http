# Ejecutar seed.py antes del archivo, sólo en POSTGRES_TEST_DB.
# API y seed deben apuntar a esa misma base de prueba; nunca a desarrollo.
# Definir REGISTRO_PASSWORD con una contraseña efímera (máximo 72 bytes).
@baseUrl = http://localhost:8000
@password = {{$processEnv REGISTRO_PASSWORD}}
# Definir LOGIN_PASSWORD_INCORRECTA distinta de REGISTRO_PASSWORD, máximo 72 bytes.
@passwordIncorrecta = {{$processEnv LOGIN_PASSWORD_INCORRECTA}}
# Para C-03 Bearer: copiar sólo el valor JWT de loginCliente a TOKEN_SOLO_BEARER
# en el entorno local del cliente HTTP; no guardarlo en este archivo.
@tokenSoloBearer = {{$processEnv TOKEN_SOLO_BEARER}}
# C-09: contraseña del usuario pendiente del seed, provista por el entorno;
# PASSWORD_NUEVA debe ser distinta, efímera y de hasta 72 bytes UTF-8.
@passwordPendiente = {{$processEnv PASSWORD_PENDIENTE}}
@passwordNueva = {{$processEnv PASSWORD_NUEVA}}
# C-01: desde EJ-5 el CRUD exige rol; el 422 se alcanza con sesión ADMIN.
@passwordAdmin = {{$processEnv PASSWORD_ADMIN}}

### C-02 — Registro atómico, correo/documento repetidos
# @name registroCliente
# @no-cookie-jar
# Esperado: 201; {"mensaje":"Registro completado","debe_cambiar_password":false,"expira_en_segundos":1800}
# La duración es configurable. Set-Cookie access_token: HttpOnly; SameSite=Lax;
# Path=/; Max-Age=duración; Secure según configuración. Sin token/hash en JSON.
# Base: usuario + rol CLIENTE + ficha + evento con el correo nuevo como actor.
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{"email":"registro-http@example.com","password":"{{password}}","nombre":"Cliente HTTP","documento":"HTTP-REG-1","telefono":"12345"}

### C-02 — Correo repetido, sin reutilizar la sesión anterior
# @name correoRepetido
# @no-cookie-jar
# Esperado: 409 {"detail":"Ya existe un usuario con ese correo."}
# Sin Set-Cookie ni filas nuevas (incluido evento); no existe ficha HTTP-REG-2.
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{"email":"registro-http@example.com","password":"{{password}}","nombre":"Cliente HTTP","documento":"HTTP-REG-2","telefono":"12345"}

### C-02 — Documento repetido
# @name documentoRepetido
# @no-cookie-jar
# Esperado: 409 {"detail":"Ya existe un cliente con ese documento."}
# Sin Set-Cookie, apropiación ni filas sueltas; no existe otro-http@example.com.
POST {{baseUrl}}/auth/registro
Content-Type: application/json

{"email":"otro-http@example.com","password":"{{password}}","nombre":"Cliente HTTP","documento":"HTTP-REG-1","telefono":"12345"}

### C-04 — Correo existente, contraseña incorrecta
# @name loginIncorrecto
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; un intento fallido confirmado, ningún evento nuevo.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-04 — Correo inexistente, mismo cuerpo y costo comparable
# @name loginInexistente
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; otro intento fallido, sin usuario/ficha/evento nuevo.
# Comparar tiempos con loginIncorrecto: ambos hacen un check bcrypt del mismo costo.
# Las mediciones repetidas y trabajo real/ficticio se verifican en test_login.py.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"inexistente-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Preparación: éxito reinicia el conteo, no borra C-04
# @name loginCliente
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Sesión iniciada","debe_cambiar_password":false,"expira_en_segundos":1800}
# Duración configurable; cookie con HttpOnly, SameSite=Lax, Path=/, Max-Age y Secure configurable.
# Sin token/hash en JSON; se agrega un intento exitoso, ningún evento nuevo.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{registroCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{password}}"}

### C-05 — Fallo 1 de 6; ejecutar los seis en menos de 60 segundos
# @name fallo1
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; agrega un intento fallido, ningún evento.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Fallo 2 de 6
# @name fallo2
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; agrega un intento fallido, ningún evento.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Fallo 3 de 6
# @name fallo3
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; agrega un intento fallido, ningún evento.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Fallo 4 de 6
# @name fallo4
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; agrega un intento fallido, ningún evento.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Fallo 5 de 6
# @name fallo5
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Sin Set-Cookie ni Retry-After; agrega el quinto fallo posterior al éxito, ningún evento.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-05 — Sexto intento bloqueado antes de buscar credenciales o ejecutar bcrypt
# @name fallo6
# @no-cookie-jar
# Esperado: 429 {"detail":"Demasiados intentos. Volvé a intentar más tarde."}
# Retry-After positivo; sin Set-Cookie; agrega exito=false y evento
# «Login bloqueado por demasiados intentos», actor registro-http@example.com.
# Hasta este bloque: nueve intentos (ocho fallidos, uno exitoso), sin borrar C-04.
# Los 429 también cuentan: Retry-After no garantiza acceso si hubo nuevos fallos.
POST {{baseUrl}}/auth/login
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{"email":"registro-http@example.com","password":"{{passwordIncorrecta}}"}

### C-03 — Cookie de registro también inicia sesión
# @name yoRegistro
# @no-cookie-jar
# Esperado: 200; usuario {id,email,nombre,debe_cambiar_password:false};
# roles_vigentes y roles_token ["CLIENTE"]. Sin hash/token ni Set-Cookie nuevo.
GET {{baseUrl}}/auth/yo
Cookie: {{registroCliente.response.headers.Set-Cookie}}

### C-03 — Identidad con cookie de login, aunque hubo fallos posteriores
# @name yoCliente
# @no-cookie-jar
# Esperado: 200; mismo cuerpo mínimo de yoRegistro, sin Set-Cookie ni escrituras.
GET {{baseUrl}}/auth/yo
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-03 — Sin cookie
# @name yoSinCookie
# @no-cookie-jar
# Esperado: 401 {"detail":"La sesión no es válida. Volvé a iniciar sesión."}; sin Set-Cookie.
GET {{baseUrl}}/auth/yo

### C-03 — Bearer válido no reemplaza la cookie
# @name yoBearer
# @no-cookie-jar
# Esperado: 401, mismo cuerpo de yoSinCookie; sin Set-Cookie ni escrituras.
GET {{baseUrl}}/auth/yo
Authorization: Bearer {{tokenSoloBearer}}

### C-01 — Preparación: sesión con el rol de la ruta (ADMIN)
# Desde EJ-5 el CRUD de clientes pide ADMIN/RECEPCION; sin ese rol el 403 del
# contrato se resuelve antes que la validación del parámetro y el 422 nunca llega.
# @name loginAdminC01
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Sesión iniciada","debe_cambiar_password":false,"expira_en_segundos":1800}
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"admin@example.com","password":"{{passwordAdmin}}"}

### C-01 — Parámetro de ruta no entero con sesión iniciada
# @name rutaInvalida
# @no-cookie-jar
# Esperado: 422 {"detail":[{"msg":"Ingresá un número entero para el cliente seleccionado."}]}
# Sin ejecutar el handler ni escribir.
GET {{baseUrl}}/clientes/no-entero
Cookie: {{loginAdminC01.response.headers.Set-Cookie}}

### Logout — Cerrar sesión con cookie
# @name logoutCliente
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Sesión cerrada"}; access_token vacío; Max-Age=0;
# Expires pasado; Path=/; HttpOnly; SameSite=Lax; Secure según emisión; sin Domain.
POST {{baseUrl}}/auth/logout
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### Logout — Después de aceptar la eliminación, no enviar otra cookie
# @name yoTrasLogout
# @no-cookie-jar
# Esperado: 401, mismo cuerpo de yoSinCookie; sin Set-Cookie ni escrituras.
GET {{baseUrl}}/auth/yo

### Logout — Sin cookie también es público
# @name logoutSinCookie
# @no-cookie-jar
# Esperado: 200, mismo cuerpo y atributos de eliminación de logoutCliente.
POST {{baseUrl}}/auth/logout

### Logout — Cookie inválida también se elimina
# @name logoutInvalido
# @no-cookie-jar
# Esperado: 200, mismo cuerpo y atributos de eliminación; sin cambios en la base.
POST {{baseUrl}}/auth/logout
Cookie: access_token=sesion-invalida

### Logout — No revoca una copia del JWT anterior
# @name yoCookieCopiada
# @no-cookie-jar
# Esperado: 200, mismo cuerpo de yoCliente mientras no venza ni cambie la contraseña.
GET {{baseUrl}}/auth/yo
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-09 parcial — Login del usuario pendiente (distinto del bloqueado por C-05)
# @name loginPendiente
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Sesión iniciada","debe_cambiar_password":true,"expira_en_segundos":1800}
# Duración configurable; Set-Cookie con los atributos de C-03, un intento exitoso.
# El bloqueo global 403 queda para EJ-5; no se demuestra ni implementa aquí.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"nuevo@example.com","password":"{{passwordPendiente}}"}

### C-09 parcial — Cambio permitido con bandera pendiente
# @name cambioPassword
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Contraseña actualizada","debe_cambiar_password":false,"expira_en_segundos":1800}
# Cookie de reemplazo sólo tras commit; mismos atributos/duración que login.
# Base: hash nuevo, password_cambiada_en con fracción, bandera false y evento
# «Cambio de contraseña», actor nuevo@example.com, todo en una transacción.
# Sin esperas artificiales: test_cambiar_password.py controla el reloj para
# probar determinísticamente login/cambio dentro del mismo segundo.
POST {{baseUrl}}/auth/cambiar-password
Content-Type: application/json
Cookie: {{loginPendiente.response.headers.Set-Cookie}}

{"password_actual":"{{passwordPendiente}}","password_nueva":"{{passwordNueva}}"}

### C-09 parcial — Cookie anterior inválida inmediatamente
# @name yoAnterior
# @no-cookie-jar
# Esperado: 401 {"detail":"La sesión no es válida. Volvé a iniciar sesión."}
# Sin Set-Cookie ni escrituras; no esperar un segundo.
GET {{baseUrl}}/auth/yo
Cookie: {{loginPendiente.response.headers.Set-Cookie}}

### C-09 parcial — Cookie nueva válida
# @name yoNueva
# @no-cookie-jar
# Esperado: 200; usuario nuevo@example.com con debe_cambiar_password:false;
# roles_vigentes y roles_token ["MECANICO"]. Sin hash/token, Set-Cookie ni escrituras.
GET {{baseUrl}}/auth/yo
Cookie: {{cambioPassword.response.headers.Set-Cookie}}

### C-09 parcial — La contraseña anterior ya no permite login
# @name loginAnterior
# @no-cookie-jar
# Esperado: 401 {"detail":"El correo o la contraseña no son correctos."}
# Un intento fallido, sin Set-Cookie ni evento nuevo.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"nuevo@example.com","password":"{{passwordPendiente}}"}

### C-09 parcial — Login con la contraseña nueva
# @name loginNueva
# @no-cookie-jar
# Esperado: 200 {"mensaje":"Sesión iniciada","debe_cambiar_password":false,"expira_en_segundos":1800}
# Cookie válida; un intento exitoso. Total: 12 intentos (9 fallidos/3 exitosos),
# cuatro eventos incluido seed (registro, bloqueo y cambio), sin borrar historial.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"nuevo@example.com","password":"{{passwordNueva}}"}
