# Órdenes de trabajo y catálogo de estados (EJ-6 — change 06-repositorios-uow-ordenes).
# Extensión REST Client de VS Code. Antes de correr ESTE archivo:  python seed.py
# El orden de los bloques importa: las altas y transiciones cambian el estado de la base.
# Definir PASSWORD_ADMIN, PASSWORD_RECEPCION, PASSWORD_MECANICO y PASSWORD_CLIENTE con las
# contraseñas del seed (viven sólo en seed.py — S-6); mecanico2@ usa la del mecánico.
# Ids del seed: admin=1, recepcion=3, mecanico=4, mecanico2=5, cliente=6 (Laura).
# Órdenes del seed: 1 (PENDIENTE, vehículo 1 de Laura) y 2 (EN_REPARACION, vehículo 3 de Jorge,
# mecánico 4). La primera orden creada por la API es la 3.
# Las marcas `creada_en`/`cuando` son fechas que varían en cada corrida.

@baseUrl = http://localhost:8000
@passwordAdmin = {{$processEnv PASSWORD_ADMIN}}
@passwordRecepcion = {{$processEnv PASSWORD_RECEPCION}}
@passwordMecanico = {{$processEnv PASSWORD_MECANICO}}
@passwordCliente = {{$processEnv PASSWORD_CLIENTE}}

### Login del administrador
# @name loginAdmin
# @no-cookie-jar
# Esperado: 200 OK
# {"mensaje": "Sesión iniciada", "debe_cambiar_password": false, "expira_en_segundos": 1800}
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"admin@example.com","password":"{{passwordAdmin}}"}

### Login de la recepción
# @name loginRecepcion
# @no-cookie-jar
# Esperado: 200 OK — mismo cuerpo que loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"recepcion@example.com","password":"{{passwordRecepcion}}"}

### Login del mecánico asignado a la orden 2
# @name loginMecanico
# @no-cookie-jar
# Esperado: 200 OK — mismo cuerpo que loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"mecanico@example.com","password":"{{passwordMecanico}}"}

### Login del segundo mecánico (sin órdenes asignadas)
# @name loginMecanico2
# @no-cookie-jar
# Esperado: 200 OK — mismo cuerpo que loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"mecanico2@example.com","password":"{{passwordMecanico}}"}

### Login del cliente Laura
# @name loginCliente
# @no-cookie-jar
# Esperado: 200 OK — mismo cuerpo que loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email":"cliente@example.com","password":"{{passwordCliente}}"}

### C-17: el catálogo de estados con sesión (cualquier rol; acá, el cliente)
# Los cuatro estados por posición; sólo TERMINADA y CANCELADA son finales (RN-19).
# Esperado: 200 OK
# [
#   {"codigo": "PENDIENTE", "descripcion": "Esperando ser tomada por un mecánico", "posicion": 1, "es_final": false},
#   {"codigo": "EN_REPARACION", "descripcion": "En curso de reparación", "posicion": 2, "es_final": false},
#   {"codigo": "TERMINADA", "descripcion": "Reparación terminada", "posicion": 3, "es_final": true},
#   {"codigo": "CANCELADA", "descripcion": "Orden cancelada", "posicion": 4, "es_final": true}
# ]
GET {{baseUrl}}/estados-orden
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-17: el mismo catálogo con la sesión del administrador
# Esperado: 200 OK — la misma lista de cuatro estados
GET {{baseUrl}}/estados-orden
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-17: sin sesión no se devuelve el catálogo
# Esperado: 401 Unauthorized
# {"detail": "La sesión no es válida. Volvé a iniciar sesión."}
GET {{baseUrl}}/estados-orden

### C-17: el catálogo no se edita desde la API
# Sólo existe GET: cualquier escritura es rechazada y las filas no cambian.
# Esperado: 405 Method Not Allowed
# {"detail": "Method Not Allowed"}
POST {{baseUrl}}/estados-orden
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"codigo":"NUEVO","descripcion":"No debería crearse","posicion":9,"es_final":false}

### C-17: listado de órdenes filtrado por un estado declarado
# Antes de crear ninguna orden: sólo la orden 1 del seed está PENDIENTE. Personal: ADMIN/RECEPCION/MECANICO.
# Esperado: 200 OK
# {"items": [{"id": 1, "vehiculo_id": 1, "estado": "PENDIENTE", "falla": "Cambio de aceite y filtro",
#   "creada_en": "<fecha>", "mecanico_id": null, "total": "56500.00"}],
#  "total": 1, "page": 1, "size": 20, "pages": 1}
GET {{baseUrl}}/ordenes?estado=PENDIENTE
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### C-17: filtro con un estado que el contrato no declara
# Esperado: 422 Unprocessable Entity — mensaje humano, sin repetir lo enviado
# {"detail": [{"msg": "Elegí un valor válido para el estado."}]}
GET {{baseUrl}}/ordenes?estado=ARCHIVADA
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### C-17: el cliente no lista todas las órdenes
# Esperado: 403 Forbidden
# {"detail": "No tenés permiso para realizar esta acción."}
GET {{baseUrl}}/ordenes
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-10: alta de una orden con dos ítems (la crea la recepción)
# Los precios se copian del repuesto y el total lo calcula el servidor; el historial queda firmado
# por la recepción (usuario 3). El stock NO baja al crear (sólo al terminar).
# Esperado: 201 Created
# {"id": 3, "estado": "PENDIENTE", "patente": "AC456EF", "total": "68000.00",
#  "creada_en": "<fecha>", "mecanico_id": null, "falla": "Ruido al frenar", "cliente": "Laura Cliente",
#  "items": [
#   {"repuesto_id": 2, "codigo": "FRE-010", "descripcion": "Pastillas de freno delanteras",
#    "cantidad": 1, "precio_unitario": "32000.00", "subtotal": "32000.00"},
#   {"repuesto_id": 4, "codigo": "ACE-530", "descripcion": "Aceite 5W30 por litro",
#    "cantidad": 3, "precio_unitario": "12000.00", "subtotal": "36000.00"}],
#  "historial": [{"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"}]}
POST {{baseUrl}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{"vehiculo_id": 2, "falla": "Ruido al frenar",
 "items": [{"repuesto_id": 2, "cantidad": 1}, {"repuesto_id": 4, "cantidad": 3}]}

### C-10: alta con un repuesto inexistente
# Esperado: 409 Conflict — la orden no queda creada (el bloque siguiente lo comprueba)
# {"detail": "Estos repuestos no existen o fueron dados de baja: 999."}
POST {{baseUrl}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{"vehiculo_id": 2, "falla": "Ruido al frenar",
 "items": [{"repuesto_id": 2, "cantidad": 1}, {"repuesto_id": 999, "cantidad": 1}]}

### C-10: la orden del 409 no existe (y la anterior sí)
# Después del alta correcta (orden 3) hay exactamente dos PENDIENTE: la 1 del seed y la 3. No hay orden 4.
# Esperado: 200 OK
# {"items": [{"id": 1, "vehiculo_id": 1, "estado": "PENDIENTE", "falla": "Cambio de aceite y filtro",
#   "creada_en": "<fecha>", "mecanico_id": null, "total": "56500.00"},
#  {"id": 3, "vehiculo_id": 2, "estado": "PENDIENTE", "falla": "Ruido al frenar",
#   "creada_en": "<fecha>", "mecanico_id": null, "total": "68000.00"}],
#  "total": 2, "page": 1, "size": 20, "pages": 1}
GET {{baseUrl}}/ordenes?estado=PENDIENTE
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### C-10: ni el mecánico ni el cliente crean órdenes
# Esperado: 403 Forbidden
# {"detail": "No tenés permiso para realizar esta acción."}
POST {{baseUrl}}/ordenes
Content-Type: application/json
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

{"vehiculo_id": 2, "falla": "Ruido al frenar", "items": [{"repuesto_id": 2, "cantidad": 1}]}

### C-06: Laura ve el detalle de su orden (la 1 es del vehículo AA111BB)
# Esperado: 200 OK
# {"id": 1, "estado": "PENDIENTE", "patente": "AA111BB", "total": "56500.00",
#  "creada_en": "<fecha>", "mecanico_id": null, "falla": "Cambio de aceite y filtro", "cliente": "Laura Cliente",
#  "items": [
#   {"repuesto_id": 1, "codigo": "FIL-001", "descripcion": "Filtro de aceite",
#    "cantidad": 1, "precio_unitario": "8500.00", "subtotal": "8500.00"},
#   {"repuesto_id": 4, "codigo": "ACE-530", "descripcion": "Aceite 5W30 por litro",
#    "cantidad": 4, "precio_unitario": "12000.00", "subtotal": "48000.00"}],
#  "historial": [{"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"}]}
GET {{baseUrl}}/ordenes/1
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-06: Laura no ve la orden de otro cliente (la 2 es del vehículo de Jorge)
# Esperado: 403 Forbidden — sin datos de la orden
# {"detail": "No tenés permiso para ver esta orden."}
GET {{baseUrl}}/ordenes/2
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-06: un mecánico ve una orden que no tiene asignada (DD-27)
# mecanico2 no tiene órdenes asignadas: el personal ve cualquiera.
# Esperado: 200 OK — el detalle de la orden 1 (mismo cuerpo que el bloque de Laura)
GET {{baseUrl}}/ordenes/1
Cookie: {{loginMecanico2.response.headers.Set-Cookie}}

### C-06: el detalle de la orden 2 con su historial cronológico
# Esperado: 200 OK
# {"id": 2, "estado": "EN_REPARACION", "patente": "ZZ999YY", "total": "26000.00",
#  "creada_en": "<fecha>", "mecanico_id": 4, "falla": "Falla de encendido", "cliente": "Jorge Sin Cuenta",
#  "items": [{"repuesto_id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido",
#    "cantidad": 4, "precio_unitario": "6500.00", "subtotal": "26000.00"}],
#  "historial": [
#   {"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "EN_REPARACION", "usuario_id": 4, "cuando": "<fecha>"}]}
GET {{baseUrl}}/ordenes/2
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-06: sin sesión siempre 401, nunca un 403 por rol
# Esperado: 401 Unauthorized
# {"detail": "La sesión no es válida. Volvé a iniciar sesión."}
GET {{baseUrl}}/ordenes/1

### Una orden que no existe
# Esperado: 404 Not Found
# {"detail": "Orden no encontrada."}
GET {{baseUrl}}/ordenes/999
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### Iniciar: el segundo mecánico toma la orden 3 (la creada en C-10)
# Sólo MECANICO inicia: la orden pasa a EN_REPARACION, queda asignada a quien la toma (usuario 5)
# y el historial suma la línea firmada por él. Responde con el detalle actualizado.
# Esperado: 200 OK
# {"id": 3, "estado": "EN_REPARACION", "patente": "AC456EF", "total": "68000.00",
#  "creada_en": "<fecha>", "mecanico_id": 5, "falla": "Ruido al frenar", "cliente": "Laura Cliente",
#  "items": [<los mismos dos ítems del alta C-10>],
#  "historial": [
#   {"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "EN_REPARACION", "usuario_id": 5, "cuando": "<fecha>"}]}
POST {{baseUrl}}/ordenes/3/iniciar
Cookie: {{loginMecanico2.response.headers.Set-Cookie}}

### Iniciar: la misma orden otra vez ya no está pendiente
# Esperado: 409 Conflict — nada cambia (sigue asignada al usuario 5)
# {"detail": "La orden ya está en reparación: no se puede iniciar."}
POST {{baseUrl}}/ordenes/3/iniciar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### Iniciar: el administrador (sin rol MECANICO) no inicia órdenes
# Esperado: 403 Forbidden
# {"detail": "No tenés permiso para realizar esta acción."}
POST {{baseUrl}}/ordenes/1/iniciar
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-11: terminar la orden 2 sin bujías suficientes (pide 4, el stock es 2)
# Sólo el mecánico asignado (usuario 4) o un ADMIN terminan. Es todo o nada: si algún ítem no alcanza,
# no se descuenta nada, no se crea ningún movimiento y la orden sigue EN_REPARACION.
# Como la operación no se confirma, NO se agenda ningún aviso en segundo plano: si mirás la consola
# de la API después de este bloque no aparece ningún «Aviso al cliente …» (RT-TX-07).
# Esperado: 409 Conflict
# {"detail": "No hay stock suficiente de Bujía de encendido (BUJ-014): hay 2 y se necesitan 4."}
POST {{baseUrl}}/ordenes/2/terminar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### C-11: la orden 2 sigue EN_REPARACION y su historial no cambió
# Esperado: 200 OK — "estado": "EN_REPARACION", "mecanico_id": 4 y sólo las dos líneas de historial del seed
# (null → PENDIENTE, PENDIENTE → EN_REPARACION)
GET {{baseUrl}}/ordenes/2
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-11: el stock de la bujía sigue en 2
# Esperado: 200 OK
# {"id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido", "precio": "6500.00", "stock": 2}
GET {{baseUrl}}/repuestos/3
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-11: no apareció ningún movimiento de salida
# Esperado: 200 OK — un único movimiento: el «Stock inicial» de +2 del seed
# [{"id": 3, "repuesto_id": 3, "orden_id": null, "usuario_id": 1, "cantidad": 2, "motivo": "Stock inicial", "cuando": "<fecha>"}]
GET {{baseUrl}}/repuestos/3/movimientos
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-12: el administrador repone 2 bujías
# Esperado: 200 OK
# {"id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido", "precio": "6500.00", "stock": 4}
POST {{baseUrl}}/repuestos/3/reponer
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{"cantidad": 2}

### C-12: ahora el mecánico asignado termina la orden 2 (queda el aviso)
# En un solo bloque: movimiento de −4, stock a 0, estado TERMINADA y línea de historial firmada por
# el mecánico (usuario 4). `mecanico_id` no cambia.
# La respuesta sale de inmediato; medio segundo DESPUÉS, en la consola de la API aparece el aviso:
#   Aviso al cliente Jorge Sin Cuenta: la orden #2 terminó y ya puede retirar el vehículo.
# (RT-TX-07: la tarea corre después de enviar la respuesta y sólo porque la operación se confirmó.)
# Esperado: 200 OK
# {"id": 2, "estado": "TERMINADA", "patente": "ZZ999YY", "total": "26000.00",
#  "creada_en": "<fecha>", "mecanico_id": 4, "falla": "Falla de encendido", "cliente": "Jorge Sin Cuenta",
#  "items": [{"repuesto_id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido",
#    "cantidad": 4, "precio_unitario": "6500.00", "subtotal": "26000.00"}],
#  "historial": [
#   {"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "EN_REPARACION", "usuario_id": 4, "cuando": "<fecha>"},
#   {"desde_estado": "EN_REPARACION", "hasta_estado": "TERMINADA", "usuario_id": 4, "cuando": "<fecha>"}]}
POST {{baseUrl}}/ordenes/2/terminar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### C-12: el stock de la bujía quedó en 0
# Esperado: 200 OK
# {"id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido", "precio": "6500.00", "stock": 0}
GET {{baseUrl}}/repuestos/3
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-12: el movimiento de salida quedó ligado a la orden y a quien la terminó
# Esperado: 200 OK — los tres movimientos en orden cronológico; el último es la salida
# [{"id": 3, "repuesto_id": 3, "orden_id": null, "usuario_id": 1, "cantidad": 2, "motivo": "Stock inicial", "cuando": "<fecha>"},
#  {"id": 5, "repuesto_id": 3, "orden_id": null, "usuario_id": 1, "cantidad": 2, "motivo": "Reposición", "cuando": "<fecha>"},
#  {"id": 6, "repuesto_id": 3, "orden_id": 2, "usuario_id": 4, "cantidad": -4,
#   "motivo": "Salida por orden de trabajo #2", "cuando": "<fecha>"}]
GET {{baseUrl}}/repuestos/3/movimientos
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

### C-12: terminar otra vez no vuelve a descontar (tampoco reenvía el aviso)
# Esperado: 409 Conflict — el stock sigue en 0
# {"detail": "La orden ya está terminada: no se puede terminar."}
POST {{baseUrl}}/ordenes/2/terminar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### Terminar: otro mecánico no puede terminar una orden que no tiene asignada
# Esperado: 403 Forbidden (antes de evaluar el estado)
# {"detail": "No tenés permiso para terminar esta orden."}
POST {{baseUrl}}/ordenes/2/terminar
Cookie: {{loginMecanico2.response.headers.Set-Cookie}}

### C-13: Laura no cancela la orden 2, que es de otro cliente (y no está pendiente)
# El permiso se evalúa ANTES que el estado: 403, nunca 409.
# Esperado: 403 Forbidden
# {"detail": "No tenés permiso para cancelar esta orden."}
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-13: un mecánico tampoco cancela (ni siquiera la orden que tiene asignada)
# Esperado: 403 Forbidden
# {"detail": "No tenés permiso para cancelar esta orden."}
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### C-13: Laura cancela su orden pendiente (la 1)
# La cancelación no toca el stock ni el mecánico; el historial suma la línea firmada por Laura (usuario 6).
# Esperado: 200 OK
# {"id": 1, "estado": "CANCELADA", "patente": "AA111BB", "total": "56500.00",
#  "creada_en": "<fecha>", "mecanico_id": null, "falla": "Cambio de aceite y filtro", "cliente": "Laura Cliente",
#  "items": [<los mismos dos ítems del bloque C-06>],
#  "historial": [
#   {"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "CANCELADA", "usuario_id": 6, "cuando": "<fecha>"}]}
POST {{baseUrl}}/ordenes/1/cancelar
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### C-13: la recepción no cancela una orden terminada (la 2 ya se terminó en C-12)
# Con permiso, el estado decide: sólo se cancela desde PENDIENTE. Nada cambia.
# Esperado: 409 Conflict
# {"detail": "La orden ya está terminada: no se puede cancelar."}
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### Cancelar: sin sesión siempre 401
# Esperado: 401 Unauthorized
# {"detail": "La sesión no es válida. Volvé a iniciar sesión."}
POST {{baseUrl}}/ordenes/1/cancelar

### C-15: la recepción crea una orden con los cuatro repuestos del seed (4 ítems)
# La orden de 4 ítems que la consigna pide medir no existe en el seed (SU-19): se crea acá.
# El stock no baja al crear, así que los cuatro ítems entran aunque la bujía quede en 0.
# Esperado: 201 Created
# {"id": 4, "estado": "PENDIENTE", "patente": "AA111BB", "total": "59000.00",
#  "creada_en": "<fecha>", "mecanico_id": null, "falla": "Inspección general", "cliente": "Laura Cliente",
#  "items": [
#   {"repuesto_id": 1, "codigo": "FIL-001", "descripcion": "Filtro de aceite",
#    "cantidad": 1, "precio_unitario": "8500.00", "subtotal": "8500.00"},
#   {"repuesto_id": 2, "codigo": "FRE-010", "descripcion": "Pastillas de freno delanteras",
#    "cantidad": 1, "precio_unitario": "32000.00", "subtotal": "32000.00"},
#   {"repuesto_id": 3, "codigo": "BUJ-014", "descripcion": "Bujía de encendido",
#    "cantidad": 1, "precio_unitario": "6500.00", "subtotal": "6500.00"},
#   {"repuesto_id": 4, "codigo": "ACE-530", "descripcion": "Aceite 5W30 por litro",
#    "cantidad": 1, "precio_unitario": "12000.00", "subtotal": "12000.00"}],
#  "historial": [{"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"}]}
POST {{baseUrl}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{"vehiculo_id": 1, "falla": "Inspección general",
 "items": [{"repuesto_id": 1, "cantidad": 1}, {"repuesto_id": 2, "cantidad": 1},
           {"repuesto_id": 3, "cantidad": 1}, {"repuesto_id": 4, "cantidad": 1}]}

### C-15: detalle de la orden 1 del seed (2 ítems) — medición de consultas
# Con SQL_ECHO=true la consola imprime las consultas de este GET: con 2 ítems son la misma
# cantidad que con 4 ítems del bloque siguiente (RT-TX-06, número fijo de consultas).
# Fragmento de consola guardado en docs/evidencias/C-15-consultas-fijas.txt (qué mirar: allí).
# Esperado: 200 OK
# {"id": 1, "estado": "CANCELADA", "patente": "AA111BB", "total": "56500.00",
#  "creada_en": "<fecha>", "mecanico_id": null, "falla": "Cambio de aceite y filtro", "cliente": "Laura Cliente",
#  "items": [<los mismos dos ítems del bloque C-06>],
#  "historial": [
#   {"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": 3, "cuando": "<fecha>"},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "CANCELADA", "usuario_id": 6, "cuando": "<fecha>"}]}
GET {{baseUrl}}/ordenes/1
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### C-15: detalle de la orden con 4 ítems (la creada arriba) — misma cantidad de consultas
# Mismo número de consultas que el bloque anterior, aunque esta orden tiene el doble de ítems:
# la precarga es selectinload/joinedload declarado en el repositorio, nada crece con los ítems.
