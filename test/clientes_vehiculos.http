# Clientes y vehículos (EJ-3 — change 03-contratos-crud). Extensión REST Client de VS Code.
# Antes de correr ESTE archivo:  python seed.py
# Los ids esperados salen del seed (TRUNCATE ... RESTART IDENTITY + setval, DD-38).
# Rutas ABIERTAS hasta EJ-5 (T-11): todavía no hay login ni cookies (D-3).

@baseUrl = http://localhost:8000

### C-01 (parte de 422): el parámetro de ruta no es un entero
# La parte «con sesión iniciada» se completa en EJ-4; este 422 lo produce FastAPI
# antes de ejecutar el handler. El traductor sólo devuelve mensajes humanos, sin repetir la entrada.
# Esperado: 422 Unprocessable Entity
# {"detail": [{"msg": "Ingresá un número entero para el cliente seleccionado."}]}
GET {{baseUrl}}/clientes/abc

### Detalle de un cliente con sus vehículos vigentes
# Esperado: 200 OK — Laura con sus 2 vehículos del seed; un dado de baja no aparecería
# {"id": 1, "nombre": "Laura Cliente", "documento": "DNI-30111222", "telefono": "11-5555-0001",
#  "vehiculos": [
#    {"id": 1, "cliente_id": 1, "patente": "AA111BB", "marca": "Fiat", "modelo": "Cronos", "anio": 2020},
#    {"id": 2, "cliente_id": 1, "patente": "AC456EF", "marca": "Toyota", "modelo": "Corolla", "anio": 2022}
#  ]}
GET {{baseUrl}}/clientes/1

### Cliente inexistente
# Esperado: 404 Not Found
# {"detail": "Cliente no encontrado."}
GET {{baseUrl}}/clientes/999999

### Alta de cliente
# Esperado: 201 Created — la respuesta nunca incluye password_hash
# {"id": 3, "nombre": "Cliente Nuevo", "documento": "DNI-90001", "telefono": "11-9000-0001"}
POST {{baseUrl}}/clientes
Content-Type: application/json

{
  "nombre": "Cliente Nuevo",
  "documento": "DNI-90001",
  "telefono": "11-9000-0001"
}

### Documento repetido: mensaje propio, sin texto de la base
# Esperado: 409 Conflict
# {"detail": "Ya existe un cliente con ese documento."}
POST {{baseUrl}}/clientes
Content-Type: application/json

{
  "nombre": "Cliente Nuevo",
  "documento": "DNI-90001",
  "telefono": "11-9000-0001"
}

### Cuerpo incompleto: nunca 500 (RN-18)
# Esperado: 422 Unprocessable Entity
# {"detail": [
#   {"msg": "Completá el documento."},
#   {"msg": "Completá el teléfono."}
# ]}
POST {{baseUrl}}/clientes
Content-Type: application/json

{
  "nombre": "Sin documento"
}

### Alta de vehículo para el cliente recién creado
# Esperado: 201 Created
# {"id": 4, "cliente_id": 3, "patente": "AA999ZZ", "marca": "Volkswagen", "modelo": "Gol", "anio": 2019}
POST {{baseUrl}}/clientes/3/vehiculos
Content-Type: application/json

{
  "patente": "AA999ZZ",
  "marca": "Volkswagen",
  "modelo": "Gol",
  "anio": 2019
}

### Patente vigente repetida en otro cliente
# Esperado: 409 Conflict
# {"detail": "Ya existe un vehículo con esa patente."}
POST {{baseUrl}}/clientes/2/vehiculos
Content-Type: application/json

{
  "patente": "AA999ZZ",
  "marca": "Toyota",
  "modelo": "Corolla",
  "anio": 2021
}

### Vehículo con orden abierta no se puede dar de baja (RN-16)
# El vehículo 3 (ZZ999YY) tiene la orden 2 EN_REPARACION (es_final = false).
# Esperado: 409 Conflict
# {"detail": "El vehículo tiene órdenes de trabajo abiertas y no se puede dar de baja."}
DELETE {{baseUrl}}/vehiculos/3

### C-19: dar de baja un vehículo sin órdenes
# El vehículo 2 (AC456EF) no tiene órdenes: baja lógica, el dato se conserva.
# Esperado: 204 No Content — sin cuerpo
DELETE {{baseUrl}}/vehiculos/2

### C-19: reutilizar la patente para otro cliente
# El índice único parcial sólo cuenta los vigentes: después de la baja, la patente queda libre.
# Esperado: 201 Created — id 6 (el intento rechazado anterior consumió el 5)
# {"id": 6, "cliente_id": 2, "patente": "AC456EF", "marca": "Toyota", "modelo": "Corolla", "anio": 2022}
POST {{baseUrl}}/clientes/2/vehiculos
Content-Type: application/json

{
  "patente": "AC456EF",
  "marca": "Toyota",
  "modelo": "Corolla",
  "anio": 2022
}

### C-19: una segunda patente vigente igual
# Esperado: 409 Conflict
# {"detail": "Ya existe un vehículo con esa patente."}
POST {{baseUrl}}/clientes/1/vehiculos
Content-Type: application/json

{
  "patente": "AC456EF",
  "marca": "Toyota",
  "modelo": "Corolla",
  "anio": 2022
}
