# Copiá este archivo como .env y completá los secretos. El .env NO se versiona.

# --- Base de datos (PostgreSQL 16) ---
POSTGRES_USER=taller
# Obligatoria, sin valor por defecto: elegí una contraseña para tu base local.
POSTGRES_PASSWORD=
POSTGRES_DB=taller
# localhost con venv; dentro de Docker Compose el servicio api usa "db" automáticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Base real que usan los tests de pytest (nunca la de desarrollo).
POSTGRES_TEST_DB=taller_test

# --- Token de sesión ---
# Obligatoria y FIJA: generala una sola vez y no la cambies (si cambia, todos se tienen que volver a loguear).
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=1800
# true en producción (cookie sólo por HTTPS).
COOKIE_SECURE=false

# --- Contraseñas (bcrypt) ---
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENCY=4

# --- Motor de base y diagnóstico ---
DB_POOL_SIZE=5
# true para ver las consultas SQL en la consola.
SQL_ECHO=false
